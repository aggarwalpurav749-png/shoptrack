# Copy this file to  server/.env  and fill it in.   (never upload .env to GitHub)

NODE_ENV=development
PORT=5000

# ── Database (PostgreSQL) ───────────────────────────────────────────
# Easiest: free Neon database -> https://neon.tech -> copy the connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Local Postgres (Termux / PC) looks like:  postgresql://postgres@localhost:5432/shoptrack

# ── Login security ──────────────────────────────────────────────────
# Any long random text (30+ characters). Make your own!
JWT_SECRET=replace-me-with-a-long-random-text-1234567890
JWT_EXPIRES_IN=7d

# First owner login (created automatically the first time the server starts).
# You are forced to change this password at first login.
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Owner

# Set to true ONCE to load demo data (3 agents, 20 products, 10 parties). Remove it afterwards.
SEED_DEMO=false

# ── Photos ──────────────────────────────────────────────────────────
# Free Cloudinary account -> Dashboard shows these 3 values.
# If left empty, photos are saved in server/uploads (fine on your own phone/PC, NOT on Render free).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Internet photo search (optional, both are free). One is enough.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Only if the website is hosted on a different address than this server (comma separated). Usually leave empty.
CORS_ORIGIN=
